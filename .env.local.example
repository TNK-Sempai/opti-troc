# =============================================================================
# Opti-Troc — variables d'environnement
# Copier ce fichier en .env.local et remplacer les valeurs placeholder.
# Ne jamais committer .env.local.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Dashboard Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon
# Clé service role : bypass les RLS, serveur uniquement, ne jamais exposer au client
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# --- Cloudinary (photos des annonces) ----------------------------------------
# Un preset d'upload UNSIGNED nommé "opti-troc" doit exister sur le compte
# (codé en dur dans lib/cloudinary/client-upload.ts)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# --- Stripe (abonnements) ----------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Fourni par `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# IDs des prix Stripe (Dashboard > Products)
STRIPE_PRICE_EARLY_BIRD=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MENSUEL=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ANNUEL=price_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Emails (Resend) ---------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Adresse expéditeur, doit appartenir à un domaine vérifié sur Resend
EMAIL_FROM=contact@opti-troc.com

# --- Application -------------------------------------------------------------
# URL de base : redirections Stripe et liens dans les emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Notifications Discord ---------------------------------------------------
# Webhook du salon admin, prévenu quand un compte payé attend validation.
# Discord > Paramètres du salon > Intégrations > Webhooks > Copier l'URL.
# Optionnel : sans cette variable, la notification est simplement ignorée.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# --- Cron Vercel -------------------------------------------------------------
# Secret partagé du cron keep-alive (vercel.json). Vercel envoie
# `Authorization: Bearer $CRON_SECRET` dès que la variable est définie sur le
# projet. Générer une valeur aléatoire : `openssl rand -hex 32`
CRON_SECRET=remplacer_par_une_chaine_aleatoire
